{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "dist",
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "*": ["./node_modules/*", "./src/types/*"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "ignore": [
      "/node_modules/(?!@consumet/extensions)"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "<node_internals>/**",
    "bin/**"
  ]
}
